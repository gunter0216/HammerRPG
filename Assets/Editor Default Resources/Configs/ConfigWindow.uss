.config-view
{
    padding: 4px;
    flex-direction: row;
}

.config-view > #LeftColumn
{
    min-width: 200px;
    max-width: 200px;
    width: 200px;
}

.search-and-filter-panel
{
    flex-direction: row;
    height: 34px;
}

.search-and-filter-panel > TextField
{
    margin-left: 0;
    margin-right: 0;
    height: 28px;
}

.search-and-filter-panel > Button
{
    margin-left: 0;
    margin-right: 0;
    width: 28px;
    height: 28px;
    padding: 4px;
}

.search-and-filter-panel > Button > Image
{
    width: 100%;
    height: 100%;
}

.action-buttons-panel
{
    margin-top: 8px;
}

.action-buttons-panel > Button
{
    margin: 0;
}

.tags-toolbar-panel
{
    height: 34px;
    min-height: 34px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.1);
}

.tags-toolbar-panel > Button
{
    margin-left: 0;
    margin-right: 0;
    width: 28px;
    height: 28px;
    padding: 4px;
}

.tags-toolbar-panel > Button > Image
{
    width: 100%;
    height: 100%;
}

.tag-element
{
    margin-top: 2px;
    background-color: rgba(255, 255, 255, 0.1);
}

.tag-element-delete-button
{
    -unity-text-align: lower-center;
    -unity-font-style: bold;
    
    border-radius: 50%;
    background-color: rgba(0, 0, 0, 0.0);
}